---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  mainClass?: string;
}

const { mainClass = 'flex-1 max-w-7xl mx-auto px-4 md:px-12 py-12 space-y-16' } = Astro.props;
---

<Layout>
  <Header />
  <main class={mainClass}>
    <slot />
  </main>
  <Footer />
</Layout>
