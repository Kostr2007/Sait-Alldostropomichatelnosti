---
import PageShell from '../layouts/PageShell.astro';
import PageHero from '../components/PageHero.astro';
---

<PageShell mainClass="flex-1 max-w-4xl mx-auto py-12 px-4 md:px-12 space-y-16">
  <!-- Вступительный блок -->
  <PageHero
    title="Достопримечательности<br />Набережных Челнов"
    subtitle="Удобный путеводитель по самым инетресным местам города!"
    titleClass="text-3xl md:text-7xl font-bold tracking-tighter text-text leading-none mb-6"
  >
    <div class="flex flex-col sm:flex-row justify-center gap-4 mt-12">
      <a
        href="/attractions"
        class="adwaita-button adwaita-button-in bg-primary hover:bg-primary-hover text-lg px-4 md:px-12 py-4"
      >
        Смотреть все достопримечательности
      </a>

      <a
        href="/map"
        class="adwaita-button adwaita-button-in bg-success hover:bg-success-hover text-lg px-4 md:px-12 py-4"
      >
        Смотреть карту
      </a>
    </div>
  </PageHero>

  <!-- Блок с популярными местами -->

  <section class="adwaita-card p-10 md:p-14">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-semibold mb-6">Добро пожаловать!</h2>
      <div class="prose prose-invert max-w-none text-lg leading-relaxed">
        <p>
          Этот сайт создан, чтобы пользователям было удобно познакомиться
          Набережными Челнам и узнать о самых интересных местах города. На
          сайте вы найдете информацию о достопримечательностях, музеях, парках
          и других интересных местах, которые стоит посетить в Набережных
          Челнах. Мы надеемся, что этот сайт поможет вам открыть для себя все
          удивительные места, которые предлагает наш город!
        </p>
        <p>
          Сделано с душой на <strong>NixOS + Astro</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Популярные места -->
  <section class="space-y-8">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl md:text-3xl font-semibold">Популярные места</h2>
      <a
        href="/attractions"
        class="nav-link text-primary hover:text-primary-hover font-medium flex items-center gap-2"
      >
        Все достопримечательности →
      </a>
    </div>

    <!-- Здесь будет сетка карточек -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Карточки достопримечательностей — делай их тоже очень "adwaita": 
           большая карточка, крупное фото с border-radius ~1.5rem, 
           заголовок крупнее, меньше текста снизу -->
    </div>
  </section>
</PageShell>
