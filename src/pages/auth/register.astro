---
import PageShell from '../../layouts/PageShell.astro';
import FormInput from '../../components/FormInput.astro';
---

<PageShell mainClass="flex-1 max-w-md mx-auto py-30 md:py-60 px-4">
  <div class="adwaita-card p-10" id="register-container">
    <!-- Заголовок и форма -->
    <div id="register-form-container">
      <h1 class="text-3xl font-semibold mb-8 text-center">Создать аккаунт</h1>
      <form id="register-form" class="space-y-6" novalidate>
        <FormInput
          type="email"
          id="email"
          placeholder="Email"
          required
        />
        <FormInput
          type="password"
          id="password"
          placeholder="Пароль (минимум 8 символов)"
          required
          minlength={8}
        />

        <button
          type="submit"
          id="submit-btn"
          class="adwaita-button w-full bg-primary hover:bg-primary-hover py-4 text-lg font-medium transition-all"
        >
          Зарегистрироваться
        </button>
      </form>
    </div>

    <!-- Блок успеха (скрыт по умолчанию) -->
    <div id="success-container" class="hidden text-center space-y-6">
      <div class="text-6xl mb-4">🎉</div>
      <h2 class="text-2xl font-semibold">Аккаунт создан!</h2>
      <p class="text-text-secondary text-lg">
        Мы отправили письмо с подтверждением на вашу почту.<br />
        <strong>Проверьте почту (включая папку "Спам")</strong>
      </p>
      <a
        href="/auth/login"
        class="adwaita-button inline-block bg-success hover:bg-success-hover px-8 py-3 text-lg"
      >
        Перейти к входу
      </a>
    </div>
  </div>
</PageShell>

<script>
  import { signUpUser, validateEmail, validatePassword } from '../../lib/auth.ts';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('register-form') as HTMLFormElement;
    const submitBtn = document.getElementById(
      'submit-btn',
    ) as HTMLButtonElement;
    const formContainer = document.getElementById('register-form-container');
    const successContainer = document.getElementById('success-container');

    if (!form) {
      console.error('Форма не найдена');
      return;
    }

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById(
        'password',
      ) as HTMLInputElement;

      const email = emailInput.value.trim();
      const password = passwordInput.value.trim();

      const emailError = validateEmail(email);
      if (emailError) {
        alert(emailError);
        emailInput.focus();
        return;
      }

      const passwordError = validatePassword(password);
      if (passwordError) {
        alert(passwordError);
        passwordInput.focus();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Регистрация...';
      }

      try {
        const result = await signUpUser(email, password);

        if (!result.success) {
          alert('Ошибка регистрации: ' + result.error);
        } else {
          if (formContainer && successContainer) {
            formContainer.classList.add('hidden');
            successContainer.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        alert('Что-то пошло не так: ' + err.message);
      } finally {
        if (
          submitBtn &&
          formContainer &&
          !formContainer.classList.contains('hidden')
        ) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Зарегистрироваться';
        }
      }
    });
  });
</script>
