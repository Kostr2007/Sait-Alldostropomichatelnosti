---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="flex-1 max-w-md mx-auto py-30 md:py-60 px-4">
    <div class="adwaita-card p-10" id="register-container">
      <!-- Заголовок и форма -->
      <div id="register-form-container">
        <h1 class="text-3xl font-semibold mb-8 text-center">Создать аккаунт</h1>
        <form id="register-form" class="space-y-6" novalidate>
          <input
            type="email"
            id="email"
            placeholder="Email"
            required
            class="w-full p-4 rounded-2xl bg-surface border border-border focus:outline-none focus:border-primary"
          />
          <input
            type="password"
            id="password"
            placeholder="Пароль (минимум 8 символов)"
            required
            minlength="8"
            class="w-full p-4 rounded-2xl bg-surface border border-border focus:outline-none focus:border-primary"
          />

          <button
            type="submit"
            id="submit-btn"
            class="adwaita-button w-full bg-primary hover:bg-primary-hover py-4 text-lg font-medium transition-all"
          >
            Зарегистрироваться
          </button>
        </form>
      </div>

      <!-- Блок успеха (скрыт по умолчанию) -->
      <div id="success-container" class="hidden text-center space-y-6">
        <div class="text-6xl mb-4">🎉</div>
        <h2 class="text-2xl font-semibold">Аккаунт создан!</h2>
        <p class="text-text-secondary text-lg">
          Мы отправили письмо с подтверждением на вашу почту.<br />
          <strong>Проверьте почту (включая папку "Спам")</strong>
        </p>
        <a
          href="/auth/login"
          class="adwaita-button inline-block bg-success hover:bg-success-hover px-8 py-3 text-lg"
        >
          Перейти к входу
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase.ts';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('register-form') as HTMLFormElement;
    const submitBtn = document.getElementById(
      'submit-btn',
    ) as HTMLButtonElement;
    const formContainer = document.getElementById('register-form-container');
    const successContainer = document.getElementById('success-container');

    if (!form) {
      return;
    }

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById(
        'password',
      ) as HTMLInputElement;

      const email = emailInput.value.trim();
      const password = passwordInput.value.trim();

      // === ВАЛИДАЦИЯ ===
      if (!email || !password) {
        alert('Пожалуйста, заполните все поля');
        return;
      }

      // Проверка email
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert('Пожалуйста, введите корректный email адрес');
        emailInput.focus();
        return;
      }

      // Проверка сложности пароля
      if (password.length < 8) {
        alert('Пароль должен быть не менее 8 символов');
        passwordInput.focus();
        return;
      }

      // Защита от самых очевидных паролей
      const easyPasswords = [
        '12345678',
        'qwertyui',
        'password',
        '11111111',
        '87654321',
        '123456789',
      ];
      if (easyPasswords.includes(password.toLowerCase())) {
        alert(
          'Этот пароль слишком простой и часто используется. Придумайте другой.',
        );
        passwordInput.focus();
        return;
      }

      const hasUpperCase = /[A-Z]/.test(password);
      const hasLowerCase = /[a-z]/.test(password);
      const hasNumbers = /\d/.test(password);
      // const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password); // можно добавить

      if (!hasUpperCase || !hasLowerCase || !hasNumbers) {
        alert(
          'Пароль должен содержать:\n• Хотя бы одну заглавную букву (A-Z)\n• Хотя бы одну строчную букву (a-z)\n• Хотя бы одну цифру (0-9)',
        );
        return;
      }

      // Если всё ок — блокируем кнопку
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Регистрация...';
      }

      try {
        const { error } = await supabase.auth.signUp({
          email: email,
          password: password,
          options: {
            emailRedirectTo: `${window.location.origin}/auth/confirm`,
          },
        });

        if (error) {
          alert('Ошибка регистрации: ' + error.message);
        } else {
          if (formContainer && successContainer) {
            formContainer.classList.add('hidden');
            successContainer.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        alert('Что-то пошло не так: ' + err.message);
      } finally {
        if (
          submitBtn &&
          formContainer &&
          !formContainer.classList.contains('hidden')
        ) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Зарегистрироваться';
        }
      }
    });
  });
</script>
