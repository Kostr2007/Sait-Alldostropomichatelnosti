---
import PageShell from '../../layouts/PageShell.astro';
import FormInput from '../../components/FormInput.astro';
---

<PageShell mainClass="flex-1 max-w-md mx-auto py-30 md:py-60 px-4">
  <div class="adwaita-card p-10">
    <h1 class="text-3xl font-semibold mb-8 text-center">Создать аккаунт</h1>

    <form id="register-form" class="space-y-6">
      <FormInput
        type="email"
        id="email"
        placeholder="Email"
        required
      />
      <FormInput
        type="password"
        id="password"
        placeholder="Пароль"
        required
      />

      <button
        type="submit"
        class="adwaita-button w-full bg-primary hover:bg-primary-hover py-4 text-lg font-medium"
      >
        Зарегистрироваться
      </button>
    </form>
  </div>
</PageShell>

<script>
  import { signUpUser } from '../../lib/auth.ts';

  const form = document.getElementById('register-form') as HTMLFormElement;

  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById(
      'password',
    ) as HTMLInputElement;

    const result = await signUpUser(emailInput.value, passwordInput.value);
    if (!result.success) {
      alert(`Ошибка регистрации: ` + result.error);
    } else {
      alert('Проверьте вашу почту для подтверждения аккаунта!');
      form.reset();
    }
  });
</script>
