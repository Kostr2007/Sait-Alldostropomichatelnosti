---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="flex-1 max-w-md mx-auto py-30 md:py-60 px-4">
    <div class="adwaita-card p-10">
      <h1 class="text-3xl font-semibold mb-8 text-center">Создать аккаунт</h1>

      <form id="register-form" class="space-y-6">
        <input
          type="email"
          id="email"
          placeholder="Email"
          required
          class="w-full p-4 rounded-2xl bg-surface border border-border focus:outline-none focus:border-primary"
        />
        <input
          type="password"
          id="password"
          placeholder="Пароль"
          required
          class="w-full p-4 rounded-2xl bg-surface border border-border focus:outline-none focus:border-primary"
        />

        <button
          type="submit"
          class="adwaita-button w-full bg-primary hover:bg-primary-hover py-4 text-lg font-medium"
        >
          Зарегистрироваться
        </button>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase.ts';

  const form = document.getElementById('register-form') as HTMLFormElement;

  if (!form) {
    console.error('Форма регистрации не найдена на странице confirm');
  } else {
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById(
        'password',
      ) as HTMLInputElement;

      if (!emailInput || !passwordInput) {
        alert('Ошибка: поля формы не найдены');
        return;
      }

      const email = emailInput.value.trim();
      const password = passwordInput.value.trim();

      if (!email || !password) {
        alert('Пожалуйста, заполните все поля');
        return;
      }

      try {
        const { error } = await supabase.auth.signUp({
          email: email,
          password: password,
          options: {
            emailRedirectTo: `${window.location.origin}/auth/confirm`,
          },
        });

        if (error) {
          alert('Ошибка регистрации: ' + error.message);
        } else {
          alert('Проверьте вашу почту для подтверждения аккаунта!');
          form.reset();
        }
      } catch (err: unknown) {
        const message =
          err instanceof Error ? err.message : 'Неизвестная ошибка';
        alert('Что-то пошло не так: ' + message);
      }
    });
  }
</script>
