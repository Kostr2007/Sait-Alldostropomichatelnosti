---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="flex-1 max-w-md mx-auto py-30 md:py-60 px-4">
    <div class="adwaita-card p-10 text-center space-y-6">
      <div class="text-6xl mb-4">✉️</div>
      <h1 class="text-3xl font-semibold">Подтверждение</h1>
      <p class="text-text-secondary text-lg">
        Подтверждение аккаунта выполняется автоматически.<br />
        Если вы перешли сюда по ссылке из письма — ваш аккаунт подтверждён.
      </p>
      <a
        href="/auth/profile"
        class="adwaita-button inline-block bg-primary hover:bg-primary-hover px-8 py-3 text-lg"
      >
        Перейти в профиль
      </a>
    </div>
  </main>
  <Footer />
</Layout>
