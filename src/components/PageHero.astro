---
interface Props {
  title: string;
  subtitle?: string;
  titleClass?: string;
}

const {
  title,
  subtitle,
  titleClass = 'text-4xl md:text-6xl font-bold tracking-tighter text-text leading-none mb-6',
} = Astro.props;
---

<section class="text-center">
  <h1 class={titleClass}>
    <Fragment set:html={title} />
  </h1>
  {subtitle && (
    <p class="text-xl md:text-2xl text-text-secondary max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
  <slot />
</section>
