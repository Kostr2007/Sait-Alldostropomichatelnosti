---
interface Props {
  type: string;
  id: string;
  placeholder: string;
  required?: boolean;
  minlength?: number;
}

const { type, id, placeholder, required = false, minlength } = Astro.props;
---

<input
  type={type}
  id={id}
  placeholder={placeholder}
  required={required}
  minlength={minlength}
  class="w-full p-4 rounded-2xl bg-surface border border-border focus:outline-none focus:border-primary"
/>
