---
const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 bg-bg/95 backdrop-blur-lg border-b border-border"
>
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Логотип -->
    <a href="/" class="flex gap-3 group">
      <div class="bg-linear-30 from-primary to-success circle-button">Ч</div>
      <div>
        <span class="text-2xl font-semibold text-text tracking-tight"
          >Челны</span
        >
        <span class="text-text-secondary text-sm block -mt-1"
          >Достопримечательности</span
        >
      </div>
    </a>

    <!-- Навигация -->
    <nav class="hidden md:flex items-center gap-8 text-text-secondary">
      <a
        href="/attractions"
        class="nav-link ${currentPath.includes('/attractions') ? 'text-text' : ''}"
      >
        Достопримечательности
      </a>

      <a
        href="/map"
        class="nav-link ${currentPath === '/map' ? 'text-text' : ''}"
      >
        Карта
      </a>

      <a
        href="/auth/profile"
        class="nav-link ${currentPath === '/auth/profile' ? 'text-text' : ''}"
      >
        Профиль
      </a>
    </nav>

    <!-- Правая часть -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="/auth/register"
        class="adwaita-button flex items-center gap-3 text-sm px-5 py-2.5 hover:bg-primary/10 transition-colors group"
      >
        <span class="text-lg transition-transform group-hover:rotate-12"
          >👤</span
        >
        <span>Аккаунт</span>
      </a>

      <button
        class="hover:bg-surface circle-button transition-colors theme-toggle-btn"
      >
        🌙
      </button>
    </div>
    <button
      id="menu-toggle"
      class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-xs hover:bg-surface transition-colors z-50"
      aria-label="Открыть меню"
    >
      <span class="hamburger-line line-1"></span>
      <span class="hamburger-line line-2"></span>
      <span class="hamburger-line line-3"></span>
    </button>
  </div>

  <div id="mobile-menu" class="md:hidden mobile-menu-panel">
    <nav class="flex flex-col gap-4 text-text-secondary text-lg">
      <a
        href="/attractions"
        class={`hover:text-text transition-colors py-2 font-medium ${currentPath.includes('/attractions') ? 'text-text' : ''}`}
      >
        Достопримечательности
      </a>
      <a
        href="/map"
        class={`hover:text-text transition-colors py-2 font-medium ${currentPath === '/map' ? 'text-text' : ''}`}
      >
        Карта
      </a>
      <a
        href="/auth/profile"
        class={`hover:text-text transition-colors py-2 font-medium ${currentPath === '/auth/profile' ? 'text-text' : ''}`}
      >
        Профиль
      </a>
      <hr class="border-white/5 my-2" />
      <div class="flex items-center justify-between pt-2">
        <a
          href="/auth/register"
          class="adwaita-button flex items-center justify-center gap-2 text-sm px-5 py-3 flex-1 mr-4 bg-surface hover:bg-primary/10 transition-all group"
        >
          <span class="text-xl transition-transform group-hover:rotate-12"
            >👤</span
          >
          <span>Аккаунт</span>
        </a>

        <button
          class="hover:bg-surface circle-button transition-colors theme-toggle-btn"
        >
          🌙
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const themeToggles = document.querySelectorAll('.theme-toggle-btn');

  if (themeToggles) {
    const isLight = document.documentElement.classList.contains('light');
    themeToggles.forEach((btn) => {
      btn.textContent = isLight ? '☀️' : '🌙';

      btn.addEventListener('click', () => {
        document.documentElement.classList.toggle('light');
        const currentIsLight =
          document.documentElement.classList.contains('light');
        localStorage.setItem('theme', currentIsLight ? 'light' : 'dark');

        // Синхронизируем иконки на ВСЕХ кнопках на странице одновременно
        document.querySelectorAll('.theme-toggle-btn').forEach((b) => {
          b.textContent = currentIsLight ? '☀️' : '🌙';
        });
      });
    });
  }

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('mobile-menu-active');
      const line1 = menuToggle.querySelector('.line-1');
      const line2 = menuToggle.querySelector('.line-2');
      const line3 = menuToggle.querySelector('.line-3');

      if (line1 && line2 && line3) {
        line1.classList.toggle('rotate-45');
        line1.classList.toggle('translate-y-2');
        line2.classList.toggle('opacity-0');
        line3.classList.toggle('-rotate-45');
        line3.classList.toggle('-translate-y-2');
      }

      if (mobileMenu) {
        mobileMenu.classList.toggle('translate-y-0');
      }
    });
  }
</script>
