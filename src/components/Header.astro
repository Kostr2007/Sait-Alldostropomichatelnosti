---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-gnome-bg/95 backdrop-blur-lg border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
    
    <!-- Логотип -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 bg-gradient-to-br from-gnome-blue to-gnome-green rounded-2xl flex items-center justify-center text-white font-bold text-xl transition-transform group-hover:scale-110">
        Ч
      </div>
      <div>
        <span class="text-2xl font-semibold text-gnome-text tracking-tight">Челны</span>
        <span class="text-gnome-text-secondary text-sm block -mt-1">Достопримечательности</span>
      </div>
    </a>

    <!-- Навигация -->
    <nav class="flex items-center gap-8 text-gnome-text-secondary">
      <a href="/attractions" 
         class="hover:text-gnome-text transition-colors font-medium ${currentPath.includes('/attractions') ? 'text-gnome-text' : ''}">
        Достопримечательности
      </a>
      
      <a href="/map" 
         class="hover:text-gnome-text transition-colors font-medium ${currentPath === '/map' ? 'text-gnome-text' : ''}">
        Карта
      </a>
      
      <a href="/routes" 
         class="hover:text-gnome-text transition-colors font-medium ${currentPath === '/routes' ? 'text-gnome-text' : ''}">
        Маршруты
      </a>
    </nav>

    <!-- Правая часть -->
    <div class="flex items-center gap-4">
      <a href="/about" 
         class="adwaita-button text-sm px-5 py-2">
        О проекте
      </a>
      
      <!-- Переключатель темы (пока заглушка) -->
      <button class="w-10 h-10 flex items-center justify-center rounded-2xl hover:bg-gnome-surface transition-colors">
        🌙
      </button>
    </div>
  </div>
</header>
